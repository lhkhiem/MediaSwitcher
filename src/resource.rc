#include <windows.h>

// Application Icon — numeric ID 101 is required for Windows Shell/taskbar to detect it.
// Named identifiers (like IDI_APPICON) are NOT found by the Windows Shell icon scanner.
#define IDI_APPICON 101
IDI_APPICON ICON "app_icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "MediaSwitcher Studio"
            VALUE "FileDescription",  "MediaSwitcher - Production Switcher & LED Broadcast Engine"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "MediaSwitcher.exe"
            VALUE "LegalCopyright",   "Copyright (C) 2026 MediaSwitcher Studio. All Rights Reserved."
            VALUE "OriginalFilename", "MediaSwitcher.exe"
            VALUE "ProductName",      "MediaSwitcher Studio"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "Developed by MediaSwitcher Development Team"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
